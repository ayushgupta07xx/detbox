# Source is normalised to LF so `cargo fmt --check` gives the same answer on
# every machine.
* text=auto eol=lf

# --- Evidence. Git must never rewrite a byte. ---------------------------------
# Golden files encode CRLF, BOMs, NULs and invalid UTF-8 on purpose: they are
# the K1 round-trip oracle. Any normalisation silently weakens the gate.
**/tests/golden/**   -text -diff -merge
**/tests/fixtures/** -text -diff -merge
fuzz/seeds/**        -text -diff -merge
corpora/**           -text -diff
benches/baselines/** -text -diff -merge
